---
import type { CollectionEntry } from "astro:content";
import SiteHeader from "../SiteHeader.astro";
import SiteFooter from "../SiteFooter.astro";
import ReferenceCaseStudy from "./ReferenceCaseStudy.astro";

type ReferenceData = CollectionEntry<"references">["data"];

interface Props {
  reference: ReferenceData;
}

const { reference } = Astro.props;
const canonical = `https://avab.eu${reference.slug}`;
const imageUrl = `https://avab.eu${reference.heroImage.src}`;
const updatedDate = reference.updatedDate ?? reference.publishedDate;
const isCaseStudy = reference.layout === "case-study" && reference.sections.length > 0;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: "https://avab.eu/" },
    { "@type": "ListItem", position: 2, name: "Referenser", item: "https://avab.eu/referenser/" },
    { "@type": "ListItem", position: 3, name: reference.shortTitle, item: canonical },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonical}#article`,
  mainEntityOfPage: { "@id": `${canonical}#webpage` },
  headline: reference.title,
  description: reference.seo.description,
  datePublished: reference.publishedDate,
  dateModified: updatedDate,
  inLanguage: "sv-SE",
  image: [imageUrl],
  author: { "@type": "Organization", name: "AVAB", url: "https://avab.eu/" },
  publisher: { "@type": "Organization", name: "AVAB", url: "https://avab.eu/" },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: reference.seo.title,
  description: reference.seo.description,
  inLanguage: "sv-SE",
  isPartOf: { "@type": "WebSite", name: "AVAB", url: "https://avab.eu/" },
  breadcrumb: { "@id": `${canonical}#breadcrumb` },
  datePublished: reference.publishedDate,
  dateModified: updatedDate,
};

const faqSchema = reference.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: reference.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
} : null;
---

<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{reference.seo.title}</title>
  <meta name="description" content={reference.seo.description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={reference.seo.noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
  <meta name="author" content="AVAB" />
  <meta name="theme-color" content="#282E29" />
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="sv_SE" />
  <meta property="og:site_name" content="AVAB" />
  <meta property="og:title" content={reference.seo.title} />
  <meta property="og:description" content={reference.seo.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:alt" content={reference.heroImage.alt} />
  <meta property="article:published_time" content={reference.publishedDate} />
  <meta property="article:modified_time" content={updatedDate} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={reference.seo.title} />
  <meta name="twitter:description" content={reference.seo.description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={reference.heroImage.alt} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" as="image" fetchpriority="high" href={reference.heroImage.src} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  {!isCaseStudy && (
    <style>
      .reference-hero { background: var(--avab-dark); color: #fff; overflow: hidden; }
      .reference-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr); align-items: stretch; min-height: 520px; }
      .reference-hero-copy { padding: clamp(64px, 8vw, 112px) 48px clamp(64px, 8vw, 112px) 0; align-self: center; }
      .reference-hero h1 { color: #fff; max-width: 820px; }
      .reference-hero .lead { color: rgba(255,255,255,.86); max-width: 760px; }
      .reference-hero-media img { width: 100%; height: 100%; min-height: 520px; object-fit: cover; display: block; }
      .reference-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border: 1px solid var(--avab-border); border-radius: var(--avab-radius-sm); background: var(--avab-white); overflow: hidden; box-shadow: var(--avab-shadow-sm); }
      .reference-fact { padding: 22px 24px; border-right: 1px solid var(--avab-border); }
      .reference-fact:last-child { border-right: 0; }
      .reference-fact span { display: block; margin-bottom: 6px; color: var(--avab-dark-muted); font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
      .reference-fact strong { color: var(--avab-dark); line-height: 1.35; }
      .reference-summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
      .reference-card { height: 100%; padding: 28px; border: 1px solid var(--avab-border); border-radius: var(--avab-radius-sm); background: var(--avab-white); box-shadow: var(--avab-shadow-sm); }
      .reference-card .eyebrow { margin-bottom: 10px; }
      .reference-card p:last-child { margin-bottom: 0; }
      .reference-scope-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
      .reference-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
      .reference-detail { padding: 30px; border: 1px solid var(--avab-border); border-radius: var(--avab-radius-sm); background: var(--avab-white); }
      .reference-detail ul { margin: 20px 0 0; padding-left: 20px; }
      .reference-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
      .reference-gallery figure { margin: 0; }
      .reference-gallery img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--avab-radius-sm); display: block; }
      .reference-gallery figcaption { margin-top: 8px; color: var(--avab-dark-muted); font-size: .9rem; }
      .reference-faq { max-width: 980px; }
      .reference-faq details { border-top: 1px solid var(--avab-border); padding: 20px 0; }
      .reference-faq details:last-child { border-bottom: 1px solid var(--avab-border); }
      .reference-faq summary { cursor: pointer; font-weight: 800; color: var(--avab-dark); }
      .reference-faq p { margin: 12px 0 0; }
      .reference-links { display: flex; flex-wrap: wrap; gap: 12px; }
      @media (max-width: 900px) {
        .reference-hero-grid { grid-template-columns: 1fr; }
        .reference-hero-copy { padding: 64px 0 42px; }
        .reference-hero-media img { min-height: 320px; max-height: 460px; }
        .reference-summary-grid, .reference-scope-grid, .reference-detail-grid, .reference-gallery { grid-template-columns: 1fr; }
        .reference-fact { border-right: 0; border-bottom: 1px solid var(--avab-border); }
        .reference-fact:last-child { border-bottom: 0; }
      }
    </style>
  )}
</head>
<body>
  <SiteHeader />

  {isCaseStudy ? (
    <ReferenceCaseStudy reference={reference} />
  ) : (
    <>
      <nav class="breadcrumbs" aria-label="Brödsmulor">
        <div class="avab-container"><ol><li><a href="/">Start</a></li><li><a href="/referenser/">Referenser</a></li><li><span aria-current="page">{reference.shortTitle}</span></li></ol></div>
      </nav>
      <main id="main">
        <section class="reference-hero"><div class="avab-container"><div class="reference-hero-grid"><div class="reference-hero-copy"><div class="eyebrow">{reference.eyebrow}</div><h1>{reference.title}</h1><p class="lead">{reference.summary}</p></div><div class="reference-hero-media"><img src={reference.heroImage.src} alt={reference.heroImage.alt} width="1200" height="800" fetchpriority="high" /></div></div></div></section>
        <section class="section section--light"><div class="avab-container"><div class="reference-facts">{reference.facts.map((fact) => <div class="reference-fact"><span>{fact.label}</span><strong>{fact.value}</strong></div>)}</div></div></section>
        <section class="section"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Uppdraget</div><h2>Referensen i ett nötskal</h2></div></div><div class="reference-summary-grid"><article class="reference-card"><div class="eyebrow">Kundens behov</div><p>{reference.needs}</p></article><article class="reference-card"><div class="eyebrow">AVAB:s ansvar</div><p>{reference.responsibility}</p></article><article class="reference-card"><div class="eyebrow">Resultatet</div><p>{reference.result}</p></article></div></div></section>
        {reference.scopeItems.length > 0 && <section class="section section--light"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Leveransomfattning</div><h2>Det här ingick i uppdraget</h2><p class="lead-dark">{reference.scope}</p></div></div><div class="reference-scope-grid">{reference.scopeItems.map((item) => <article class="reference-card">{item.label && <div class="eyebrow">{item.label}</div>}<h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>}
        {reference.detailSections.length > 0 && <section class="section"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Fördjupning</div><h2>Tekniken bakom leveransen</h2></div></div><div class="reference-detail-grid">{reference.detailSections.map((section) => <article class="reference-detail">{section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}<h3>{section.title}</h3><p>{section.text}</p>{section.bullets.length > 0 && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}</article>)}</div></div></section>}
        {reference.gallery.length > 1 && <section class="section section--light"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Bilder</div><h2>Från projektet</h2></div></div><div class="reference-gallery">{reference.gallery.map((image) => <figure><img src={image.src} alt={image.alt} loading="lazy" width="900" height="600" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div></div></section>}
        {reference.faq.length > 0 && <section class="section"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Vanliga frågor</div><h2>Om {reference.shortTitle}</h2></div></div><div class="reference-faq">{reference.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>}
        <section class="section section--light"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Relaterat</div><h2>Tjänster i projektet</h2></div></div><div class="reference-links">{reference.relatedServices.map((service) => <a class="button button--secondary" href={service.href}>{service.label}</a>)}</div></div></section>
        <section class="section section--dark"><div class="avab-container"><div class="section-heading"><div><div class="eyebrow">Nästa projekt</div><h2 style="color:#fff;">Planerar du ett liknande projekt?</h2><p class="lead" style="color:rgba(255,255,255,.82);">Skicka underlag eller boka en genomgång så hjälper AVAB till från projektering till färdig installation.</p></div></div><a class="button" href="/kontakt/">Kontakta AVAB</a></div></section>
      </main>
    </>
  )}

  <SiteFooter />
</body>
</html>
