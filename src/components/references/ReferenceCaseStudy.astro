---
import type { CollectionEntry } from "astro:content";

type ReferenceData = CollectionEntry<"references">["data"];

interface Props {
  reference: ReferenceData;
}

const { reference } = Astro.props;
const sectionClass = (tone: "default" | "light") => tone === "light" ? "section section--light" : "section";
const actionClass = (variant: "primary" | "secondary" | "quiet") => {
  if (variant === "secondary") return "button button-secondary";
  if (variant === "quiet") return "button button-quiet";
  return "button button-primary";
};
---

<nav class="breadcrumbs" aria-label="Brödsmulor">
  <div class="avab-container">
    <ol>
      <li><a href="/">Start</a></li>
      <li><a href="/referenser/">Referenser</a></li>
      <li><span aria-current="page">{reference.shortTitle}</span></li>
    </ol>
  </div>
</nav>

<section class="case-hero" style={`--case-hero-image:url('${reference.heroImage.src}')`}>
  <div class="avab-container">
    <div class="case-hero-inner">
      <div class="eyebrow">{reference.eyebrow}</div>
      <h1>{reference.title}</h1>
      <p class="lead">{reference.summary}</p>
      {reference.heroActions.length > 0 && (
        <div class="case-actions">
          {reference.heroActions.map((action) => (
            <a class={actionClass(action.variant)} href={action.href}>{action.label}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<section class="case-fact-band" aria-label="Projektfakta">
  <div class="case-fact-grid">
    {reference.facts.map((fact) => (
      <div class="case-fact"><span>{fact.label}</span><strong>{fact.value}</strong></div>
    ))}
  </div>
</section>

<main id="main">
  {reference.sections.map((section) => (
    <section class={sectionClass(section.tone)} id={section.id}>
      <div class="avab-container">
        {section.type === "intro" && (
          <>
            <div class="case-heading">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="case-card-grid case-card-grid--4">
              {section.cards.map((card) => (
                <article class="case-card">
                  {card.label && <div class="case-label">{card.label}</div>}
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </article>
              ))}
            </div>
          </>
        )}

        {section.type === "mediaText" && (
          <div class:list={["case-media-grid", section.mediaSide === "left" && "case-media-grid--left"]}>
            <div class="case-media-copy">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets.length > 0 && <ul class="bullet-list">{section.bullets.map((item) => <li>{item}</li>)}</ul>}
              {section.steps.length > 0 && (
                <div class="case-step-grid">
                  {section.steps.map((step) => (
                    <div class="case-step">
                      <strong>{step.label && <em>{step.label}</em>}{step.title}</strong>
                      <span>{step.text}</span>
                    </div>
                  ))}
                </div>
              )}
              {section.snippet && (
                <aside class="case-snippet">
                  <span>{section.snippet.label}</span>
                  <h3>{section.snippet.title}</h3>
                  <p>{section.snippet.text}</p>
                </aside>
              )}
            </div>
            <figure class="case-media">
              {section.image ? (
                <>
                  <img src={section.image.src} alt={section.image.alt} loading="lazy" width="1280" height="800" />
                  {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
                </>
              ) : (
                <div class="case-media-placeholder" aria-hidden="true"></div>
              )}
            </figure>
          </div>
        )}

        {section.type === "metrics" && (
          <>
            <div class="case-heading">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
            </div>
            <div class="case-metrics">
              {section.items.map((item) => <div class="case-metric"><strong>{item.value}</strong><span>{item.label}</span></div>)}
            </div>
          </>
        )}

        {section.type === "cards" && (
          <>
            <div class="case-heading">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="case-card-grid" style={`--case-columns:${section.columns}`}>
              {section.cards.map((card) => (
                <article class="case-card">
                  {card.label && <div class="case-label">{card.label}</div>}
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </article>
              ))}
            </div>
          </>
        )}

        {section.type === "gallery" && (
          <>
            <div class="case-heading">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
            </div>
            <div class="case-gallery">
              {section.images.map((image) => (
                <figure>
                  <img src={image.src} alt={image.alt} loading="lazy" width="1200" height="800" />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </>
        )}

        {section.type === "flow" && (
          <div class="case-flow-wrap">
            <div class="case-heading">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="case-flow">
              {section.nodes.map((node, index) => (
                <>
                  <div class="case-flow-node">{node}</div>
                  {index < section.nodes.length - 1 && <div class="case-flow-arrow" aria-hidden="true">→</div>}
                </>
              ))}
            </div>
          </div>
        )}

        {section.type === "proof" && (
          <>
            <div class="case-heading">
              {section.eyebrow && <div class="eyebrow">{section.eyebrow}</div>}
              <h2>{section.title}</h2>
              {section.lead && <p class="lead-dark">{section.lead}</p>}
            </div>
            <div class="case-proof-strip">
              {section.items.map((item) => <div class="case-proof"><strong>{item.value}</strong><span>{item.label}</span></div>)}
            </div>
          </>
        )}
      </div>
    </section>
  ))}

  {reference.faq.length > 0 && (
    <section class="section case-faq-section">
      <div class="avab-container">
        <div class="case-faq-heading">
          <div class="eyebrow">{reference.faqIntro?.eyebrow ?? "Vanliga frågor"}</div>
          <h2>{reference.faqIntro?.title ?? `Frågor om ${reference.shortTitle}`}</h2>
          {reference.faqIntro?.text && <p>{reference.faqIntro.text}</p>}
        </div>
        <div class="case-faq">
          {reference.faq.map((item) => (
            <details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>
          ))}
        </div>

        {reference.closingCta && (
          <div class="case-closing-cta">
            <div>
              {reference.closingCta.eyebrow && <div class="eyebrow">{reference.closingCta.eyebrow}</div>}
              <h2>{reference.closingCta.title}</h2>
              <p>{reference.closingCta.text}</p>
              <div class="case-actions">
                {reference.closingCta.actions.map((action) => (
                  <a class={actionClass(action.variant)} href={action.href}>{action.label}</a>
                ))}
              </div>
            </div>
            {reference.closingCta.bullets.length > 0 && (
              <ul class="case-cta-list">{reference.closingCta.bullets.map((item) => <li>{item}</li>)}</ul>
            )}
          </div>
        )}
      </div>
    </section>
  )}
</main>

<style>
  .case-hero { position: relative; color: #fff; background: linear-gradient(90deg, rgba(24,29,25,.94) 0%, rgba(24,29,25,.80) 47%, rgba(24,29,25,.28) 100%), var(--case-hero-image) center/cover no-repeat; }
  .case-hero-inner { max-width: 900px; padding: clamp(76px, 9vw, 132px) 0; }
  .case-hero h1 { color: #fff; max-width: 900px; }
  .case-hero .lead { max-width: 820px; color: rgba(255,255,255,.9); }
  .case-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; align-items: center; }

  .case-fact-band { background: var(--avab-white); border-bottom: 1px solid var(--avab-border); }
  .case-fact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); max-width: 1440px; margin: 0 auto; }
  .case-fact { padding: 22px 24px; border-right: 1px solid var(--avab-border); }
  .case-fact:last-child { border-right: 0; }
  .case-fact span { display: block; margin-bottom: 6px; color: var(--avab-dark-muted); font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  .case-fact strong { display: block; color: var(--avab-dark); line-height: 1.35; }

  .case-heading { max-width: 880px; }
  .case-card-grid { display: grid; grid-template-columns: repeat(var(--case-columns, 3), minmax(0,1fr)); gap: 18px; margin-top: 34px; align-items: start; }
  .case-card-grid--4 { --case-columns: 4; }
  .case-card { padding: 28px; background: var(--avab-white); border: 1px solid var(--avab-border); border-radius: var(--avab-radius-sm); box-shadow: var(--avab-shadow-sm); }
  .case-card p:last-child { margin-bottom: 0; }
  .case-label { margin-bottom: 10px; color: var(--avab-green); font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }

  .case-media-grid { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr); gap: clamp(34px,5vw,72px); align-items: start; }
  .case-media-grid--left .case-media { order: -1; }
  .case-media img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--avab-radius-sm); display: block; }
  .case-media figcaption { margin-top: 10px; color: var(--avab-dark-muted); font-size: .88rem; }
  .case-media-placeholder { min-height: 340px; border-radius: var(--avab-radius-sm); background: var(--avab-grey); border: 1px dashed var(--avab-border); }

  .case-step-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; margin-top: 28px; }
  .case-step { padding: 18px; border: 1px solid var(--avab-border); border-radius: var(--avab-radius-sm); background: var(--avab-white); }
  .case-step strong, .case-step span { display: block; }
  .case-step strong { margin-bottom: 6px; }
  .case-step em { display: inline-grid; place-items: center; width: 24px; height: 24px; margin-right: 8px; border-radius: 50%; background: var(--avab-green); color: #fff; font-size: .75rem; font-style: normal; }
  .case-step span { color: var(--avab-dark-muted); font-size: .9rem; }

  .case-snippet { margin-top: 28px; padding: 28px 30px; background: var(--avab-white); border: 1px solid var(--avab-border); border-left: 6px solid var(--avab-green); border-radius: var(--avab-radius-sm); box-shadow: var(--avab-shadow-sm); }
  .case-snippet > span { display: block; margin-bottom: 8px; color: var(--avab-green); font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  .case-snippet p:last-child { margin-bottom: 0; }

  .case-metrics { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; margin-top: 34px; }
  .case-metric { padding: 28px 22px; border: 1px solid var(--avab-border); border-top: 4px solid var(--avab-green); border-radius: var(--avab-radius-sm); background: var(--avab-white); box-shadow: var(--avab-shadow-sm); }
  .case-metric strong, .case-metric span { display: block; }
  .case-metric strong { margin-bottom: 8px; color: var(--avab-dark); font-size: 1.3rem; }
  .case-metric span { color: var(--avab-dark-muted); font-size: .92rem; }

  .case-gallery { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; margin-top: 34px; }
  .case-gallery figure { margin: 0; }
  .case-gallery img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--avab-radius-sm); display: block; }
  .case-gallery figcaption { margin-top: 10px; color: var(--avab-dark-muted); font-size: .88rem; }

  .case-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 16px; align-items: center; margin-top: 30px; }
  .case-flow-node { min-height: 110px; display: grid; place-items: center; padding: 18px; border: 1px solid var(--avab-border); border-radius: var(--avab-radius-sm); background: var(--avab-white); box-shadow: var(--avab-shadow-sm); text-align: center; font-weight: 700; }
  .case-flow-arrow { color: var(--avab-green); font-size: 1.8rem; font-weight: 800; }

  .case-proof-strip { display: grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); margin-top: 32px; border-top: 1px solid var(--avab-border); border-bottom: 1px solid var(--avab-border); }
  .case-proof { padding: 24px; text-align: center; }
  .case-proof strong, .case-proof span { display: block; }
  .case-proof strong { color: var(--avab-green); font-size: clamp(1.8rem,3vw,2.7rem); line-height: 1.1; }
  .case-proof span { margin-top: 8px; color: var(--avab-dark-muted); font-size: .9rem; }

  .case-faq-heading { max-width: 760px; margin-bottom: 30px; }
  .case-faq-heading p { color: var(--avab-dark-muted); }
  .case-faq { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 28px; max-width: 1060px; margin: 0 auto 64px; }
  .case-faq details { padding: 20px 0; border-top: 1px solid var(--avab-border); }
  .case-faq summary { cursor: pointer; font-weight: 800; color: var(--avab-dark); }
  .case-faq details p { margin: 12px 0 0; }

  .case-closing-cta { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(280px,.75fr); gap: 48px; padding: clamp(34px,5vw,58px); border-radius: var(--avab-radius-sm); background: var(--avab-dark); color: #fff; }
  .case-closing-cta h2 { color: #fff; }
  .case-closing-cta p { color: rgba(255,255,255,.82); }
  .case-cta-list { margin: 0; padding-left: 20px; align-self: center; }
  .case-cta-list li { margin: 8px 0; }

  @media (max-width: 1024px) {
    .case-card-grid, .case-card-grid--4, .case-step-grid, .case-metrics { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .case-flow { grid-template-columns: 1fr; }
    .case-flow-arrow { transform: rotate(90deg); justify-self: center; }
  }

  @media (max-width: 768px) {
    .case-hero-inner { padding: 64px 0 72px; }
    .case-actions { align-items: stretch; }
    .case-actions .button { width: 100%; justify-content: center; }
    .case-fact-grid { grid-template-columns: 1fr 1fr; }
    .case-fact { border-bottom: 1px solid var(--avab-border); }
    .case-card-grid, .case-card-grid--4, .case-step-grid, .case-metrics, .case-gallery, .case-faq, .case-closing-cta { grid-template-columns: 1fr; }
    .case-media-grid { grid-template-columns: 1fr; gap: 30px; }
    .case-media-grid--left .case-media { order: 0; }
    .case-media { order: 0; }
    .case-media-copy { order: -1; }
    .case-faq { margin-bottom: 44px; }
    .case-closing-cta { gap: 26px; }
  }
</style>
