---
// Ett helt klickbart referenskort för översikten på /referenser/.
// Under migration används content collection när en motsvarande entry finns.
import { getEntry } from "astro:content";
import type { Reference, FilterOption } from "../data/referenser";

interface Props {
  reference: Reference;
  environments: FilterOption[];
  technologies: FilterOption[];
}

const { reference, environments, technologies } = Astro.props;
const contentId = reference.slug.replace(/^\/referenser\//, "").replace(/\/$/, "");
const contentEntry = contentId ? await getEntry("references", contentId) : undefined;

const effectiveReference: Reference = contentEntry ? {
  title: contentEntry.data.shortTitle,
  slug: contentEntry.data.slug,
  location: contentEntry.data.location.publicDisplay,
  image: contentEntry.data.heroImage.src,
  imageAlt: contentEntry.data.heroImage.alt,
  excerpt: contentEntry.data.summary,
  environments: contentEntry.data.environments,
  technologies: contentEntry.data.technologies,
  featured: contentEntry.data.featured,
} : reference;

const envLabels = effectiveReference.environments
  .map((id) => environments.find((e) => e.id === id)?.label)
  .filter(Boolean) as string[];

const techLabels = effectiveReference.technologies
  .map((id) => technologies.find((t) => t.id === id)?.label)
  .filter(Boolean) as string[];

const shownTech = techLabels.slice(0, 4);
const extraTech = techLabels.length - shownTech.length;
---

<a
  class="ref-card ref-filter-card"
  href={effectiveReference.slug}
  data-environments={effectiveReference.environments.join(" ")}
  data-technologies={effectiveReference.technologies.join(" ")}
  data-title={effectiveReference.title.toLowerCase()}
  data-location={effectiveReference.location.toLowerCase()}
  data-excerpt={effectiveReference.excerpt.toLowerCase()}
  data-featured={effectiveReference.featured ? "true" : "false"}
>
  <img
    src={effectiveReference.image}
    alt={effectiveReference.imageAlt}
    width="900"
    height="600"
    loading="lazy"
    decoding="async"
  />
  <div class="ref-content">
    <span class="ref-meta">{envLabels[0]}{effectiveReference.location ? ` · ${effectiveReference.location}` : ""}</span>
    <h3>{effectiveReference.title}</h3>
    <p>{effectiveReference.excerpt}</p>
    {shownTech.length > 0 && (
      <ul class="ref-pills" aria-label="Teknik i projektet">
        {shownTech.map((label) => <li>{label}</li>)}
        {extraTech > 0 && <li class="ref-pill-more">+{extraTech}</li>}
      </ul>
    )}
    <span class="ref-cta">Läs referensen</span>
  </div>
</a>
